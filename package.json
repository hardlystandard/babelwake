{
  "name": "babelwake",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:validate": "node --import tsx scripts/validate-content.ts",
    "content:review": "node --import tsx scripts/review.ts",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run content:validate && npm test && npm run build"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "tsx": "^4.20.0"
  }
}
